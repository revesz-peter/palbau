# Public URL of the site, used for canonical links and social images.
NEXT_PUBLIC_SITE_URL=https://www.example.hu

# Cal.com booking link: a full URL or a slug such as "pal-sandor/bemutatohaz".
# Leave empty to hide the booking button. The contact form stays available.
NEXT_PUBLIC_CAL_LINK=

# Resend (https://resend.com) sends the contact form emails.
RESEND_API_KEY=
# Inbox that receives the inquiries.
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend. Without it, Resend only delivers
# test mail to the owner of the Resend account.
CONTACT_FROM_EMAIL=Pal Sandor weboldal <onboarding@resend.dev>
